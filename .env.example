# ──────────────────────────────────────────────
#  dev-cognition-system — Environment Template
#  Copy this file to .env and fill in your values
# ──────────────────────────────────────────────

# Local Ollama — OpenAI-compatible endpoint
OLLAMA_URL=http://localhost:11434/v1/chat/completions

# LLM model to use (must be pulled via: ollama pull <model>)
OLLAMA_MODEL=qwen2.5-coder:14b

# Minimum seconds between consecutive Ollama API calls (0 = no throttle for local)
OLLAMA_MIN_INTERVAL=0

# Keep model loaded in VRAM indefinitely (-1 = never unload)
OLLAMA_KEEP_ALIVE=-1

# Output directory where Obsidian vault notes are written
VAULT_PATH=./vault

# Set to 1 to skip Ollama calls and use heuristic fallback instead (useful for offline testing)
MOCK_LLM=0
